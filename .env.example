# 0 = First USB Webcam (Logitech Brio 4K)
# You can also set CAMERA_SOURCE=sample_street.mp4 to test with a video file first!
CAMERA_SOURCE=0

# "local" = 100% Free using Ollama (qwen2.5vl:3b) on your RTX 4060
# "openrouter" = Ultra-cheap Cloud VLM fallback (~$2/month)
CLASSIFIER_MODE=local

OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5vl:3b

# Only needed if CLASSIFIER_MODE=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-vl-7b-instruct
